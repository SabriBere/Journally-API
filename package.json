{
    "engines": {
        "node": "22.x"
    },
    "name": "journallyappback",
    "version": "1.0.1",
    "description": "Backend API for Journally an application built with Node.js, Express, Prisma, and TypeScript.",
    "main": "index.ts",
    "scripts": {
        "test": "jest",
        "test:ci": "jest --runInBand",
        "start": "node dist/src/index.js",
        "start:prod": "node --env-file=.env.prod dist/src/index.js",
        "dev": "node --env-file=.env.dev --watch --watch-preserve-output -r ts-node/register src/index.ts",
        "db:start": "docker compose up -d --wait db",
        "db:stop": "docker compose stop db",
        "db:status": "docker compose ps db",
        "db:logs": "docker compose logs -f db",
        "db:migrate:dev": "node --env-file=.env.dev ./node_modules/prisma/build/index.js migrate deploy",
        "db:migrate:deploy": "prisma migrate deploy",
        "generate": "prisma generate",
        "migrate": "node --env-file=.env.dev ./node_modules/prisma/build/index.js migrate dev",
        "build": "tsc"
    },
    "author": "Sabrina Demetrio",
    "license": "MIT",
    "keywords": [
        "journaling",
        "api",
        "rest-api",
        "nodejs",
        "express",
        "prisma",
        "typescript",
        "bcrypt",
        "backend",
        "postgresql",
        "typescript-api"
    ],
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-validator": "^7.3.2",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "ws": "^8.20.1"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.18",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.19.19",
        "@types/supertest": "^7.2.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/ws": "^8.18.1",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.4.2",
        "prettier": "^3.8.3",
        "prisma": "^6.19.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.10",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
